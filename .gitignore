web/node_modules/
web/dist/
web/public/autonation.wasm
web/public/wasm_exec.js
web/tsconfig.tsbuildinfo

# Terraform plugin and state artifacts from local validation runs.
.terraform/
*.tfstate
*.tfstate.*
terraform.tfplan

# Go build output.
*.exe
*.test
